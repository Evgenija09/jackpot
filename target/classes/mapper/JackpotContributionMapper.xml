<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sporty.jackpot.infrastructure.persistence.mapper.JackpotContributionMyBatisMapper">

    <resultMap id="contributionResultMap" type="com.sporty.jackpot.infrastructure.persistence.entity.JackpotContributionEntity">
        <id     property="id"                   column="id"/>
        <result property="betId"                column="bet_id"/>
        <result property="userId"               column="user_id"/>
        <result property="jackpotId"            column="jackpot_id"/>
        <result property="stakeAmount"          column="stake_amount"/>
        <result property="contributionAmount"   column="contribution_amount"/>
        <result property="currentJackpotAmount" column="current_jackpot_amount"/>
        <result property="createdAt"            column="created_at"/>
    </resultMap>

    <select id="existsByBetId" parameterType="String" resultType="boolean">
        SELECT COUNT(1) > 0
        FROM jackpot_contribution
        WHERE bet_id = #{betId}
    </select>

    <select id="findByBetId" parameterType="String" resultMap="contributionResultMap">
        SELECT id,
               bet_id,
               user_id,
               jackpot_id,
               stake_amount,
               contribution_amount,
               current_jackpot_amount,
               created_at
        FROM jackpot_contribution
        WHERE bet_id = #{betId}
    </select>

    <insert id="save"
            parameterType="com.sporty.jackpot.infrastructure.persistence.entity.JackpotContributionEntity"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO jackpot_contribution (bet_id,
                                         user_id,
                                         jackpot_id,
                                         stake_amount,
                                         contribution_amount,
                                         current_jackpot_amount,
                                         created_at)
        VALUES (#{betId},
                #{userId},
                #{jackpotId},
                #{stakeAmount},
                #{contributionAmount},
                #{currentJackpotAmount},
                #{createdAt})
    </insert>

    <select id="countByBetId" parameterType="String" resultType="long">
        SELECT COUNT(1)
        FROM jackpot_contribution
        WHERE bet_id = #{betId}
    </select>

</mapper>
